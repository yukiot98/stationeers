define ana 435685051
define switch 321604921
define mix HASH("mixer")
define outscan HASH("outputscan")
define in1 HASH("inscan1")
define in2 HASH("inscan2")
define in3 HASH("inscan3")
alias p1 d0
alias p2 d1
alias p3 d2
alias meme d4
alias memi d5
define set1 8000 #set desired ratio from input 1
define set2 4000 #set desired ratio from input 2
define set3 2 #set desired ratio from input 3
define maxpress 20000 #max pressure in kpa, failsafe
define setpoint 1000 #desired pressure
define minpress 100 #below this pump a bit off input 1
define kp 0.1
define ki 0
alias n r11
alias T r10
alias P r9
alias V r8
alias V1 r5
alias V2 r6
alias V3 r7
define R 8.3144
alias outmole r1
alias out r2
alias outpress r3

alias input r13
alias int r14
#below here find and edit any ratiogas to your desired gas you wish to mix
start:
yield
sbn ana outscan On 1
lbn outpress ana outscan Pressure 3
lbn r0 switch mix Setting 3
jal input1
jal input2
brdns p3 2
jal input3
jal pumps
input1:
lbn T ana in1 Temperature 3
lbn P ana in1 Pressure 3
lbn outmole ana outscan TotalMoles 3
lbn out ana outscan RatioMethane 3
mul outmole outmole out
sub n set1 outmole
push ra
jal calcV
move V1 V
pop ra
j ra
input2:
lbn T ana in2 Temperature 3
lbn P ana in2 Pressure 3
lbn outmole ana outscan TotalMoles 3
lbn out ana outscan RatioOxygen 3
mul outmole outmole out
sub n set2 outmole
push ra
jal calcV
move V2 V
pop ra
j ra
input3:
lbn T ana in3 Temperature 3
lbn P ana in3 Pressure 3
lbn outmole ana outscan TotalMoles 3
lbn out ana outscan RatioOxygen 3
mul outmole outmole out
sub n set3 outmole
push ra
jal calcV
move V3 V
pop ra
j ra
pumps:
yield
lbn outpress ana outscan Pressure 3
lbn r0 switch mix Setting 3
sle outpress outpress maxpress
and r0 r0 outpress
s p1 Setting V1
s p2 Setting V2
sgtz input V1
and int r0 input
s p1 On int
sgtz input V2
and int r0 input
s p2 On int
brdns p3 5
s p3 Setting V3
sgtz input V3
and int r0 input
s p3 On r0
j start
calcV:
mul V n R
mul V V T
div V V P
mul V V kp
j ra